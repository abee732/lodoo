<odoo>
    <record id="view_dkms_tag_tree" model="ir.ui.view">
        <field name="model">dkms.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="color"/>
            </tree>
        </field>
    </record>

    <record id="action_dkms_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">dkms.tag</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>