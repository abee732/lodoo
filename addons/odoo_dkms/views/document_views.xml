<odoo>
    <record id="view_dkms_document_tree" model="ir.ui.view">
        <field name="model">dkms.document</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="folder_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_dkms_document_form" model="ir.ui.view">
        <field name="model">dkms.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_submit_review" type="object" string="Submit Review"
                        states="draft"/>
                    <button name="action_approve" type="object" string="Approve"
                        states="review"/>
                    <button name="action_publish" type="object" string="Publish"
                        states="approved"/>
                    <button name="action_archive" type="object" string="Archive"
                        states="published"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="folder_id"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>

                    <notebook>
                        <page string="Content">
                            <field name="content"/>
                        </page>
                        <page string="Attachment">
                            <field name="file" filename="filename"/>
                        </page>
                        <page string="Versions">
                            <field name="version_ids">
                                <tree>
                                    <field name="version"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dkms_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">dkms.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>