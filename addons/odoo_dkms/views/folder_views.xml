<odoo>
    <record id="view_dkms_folder_tree" model="ir.ui.view">
        <field name="model">dkms.folder</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="parent_id"/>
            </tree>
        </field>
    </record>

    <record id="view_dkms_folder_form" model="ir.ui.view">
        <field name="model">dkms.folder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dkms_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">dkms.folder</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>